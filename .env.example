# ASPAR Franchise — Social Media Pipeline
# Copiez ce fichier vers .env et remplissez vos credentials

# ─── Notion ──────────────────────────────────────────────────────────────────
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Canva ───────────────────────────────────────────────────────────────────
CANVA_API_KEY=xxx

# ─── n8n MCP ─────────────────────────────────────────────────────────────────
N8N_MCP_URL=https://notoria.app.n8n.cloud/mcp-server/http
N8N_API_KEY=xxx

# ─── Buffer ───────────────────────────────────────────────────────────────────
BUFFER_ACCESS_TOKEN=xxx
BUFFER_PROFILE_LINKEDIN=xxx
BUFFER_PROFILE_INSTAGRAM=xxx
BUFFER_PROFILE_FACEBOOK=xxx

# ─── Twin (TikTok/Pinterest) ──────────────────────────────────────────────────
TWIN_WEBHOOK_URL=https://xxx.twin.so/webhook
TWIN_API_KEY=xxx

# ─── Gmail ───────────────────────────────────────────────────────────────────
GMAIL_RECIPIENT=majdi@aspar-franchise.com
GMAIL_CREDENTIALS=./credentials/gmail.json

# ─── Slack ────────────────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_CHANNEL=#social-media-pipeline

# ─── Genspark (si utilisé pour visuels) ──────────────────────────────────────
GENSPARK_API_KEY=xxx
